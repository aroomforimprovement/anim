
/*
 * To create a layer, make a folder next to the pde file called 'layer' and turn on layer mode
 *
 * ENTER = createFrames (live painting current frame)
 * SHIFT = setBg
 * ALT = WHITE / BLACK
 * LEFT = start forward loop
 * RIGHT = render forward loop
 * UP = start backward loop
 * DOWN = render backward loop
 * 0 = black
 * 1 - 7 = size
 * x = wipe background
 * s = single line
 * m = mirrored line
 * l = lake (horizontal mirror) line
 * i = india (mandala) line
 * c = layer mode ON / OFF
 * t = trace mode ON / OFF
 * q = trace over mode ON / OFF
 * r = red, g = green, b = blue, y = yellow, w = white, 9 = shade,
 * z = transparent, p = purple, u = brown, o = orange, h = grey
 * ctrl = next
 * [ / ] = lighter / darker
 * v = colour picker
 * , / . = alpha +- 5
 * - / = = alpha +- 100
 * a = New Layer
 * f = fill / bucket mode
 *
 */

final color PEN_WHITE = color(255, 200);
final color PEN_TRANSPARENT = color(255, 10);
final color PEN_BLACK = color(0);
final color PEN_SHADE = color(0, 10);
final color PEN_GREY = color(150, 10);
final color PEN_RED = color(185, 70, 70, 10);
final color PEN_BLUE = color(120, 210, 230, 10);
final color PEN_GREEN = color(30, 145, 30, 10);
final color PEN_YELLOW = color(255, 255, 100, 10);
final color PEN_PURPLE = color(221, 211, 255, 10);
final color PEN_ORANGE = color(60, 47, 0, 10);
final color PEN_BROWN = color(223, 183, 60, 10);


enum DrawMode {
  SINGLE, MIRROR, LAKE, INDIA
}


// ------------------------------------------------------------
// GLOBALS
// ------------------------------------------------------------

int bgColor = 0;
int liveDrawingThreshold = 40;

ArrayList<Point> points = new ArrayList<Point>();
ArrayList<Fill> fills = new ArrayList<Fill>();

// Current frame drawing actions.
// This preserves the exact order in which points and fills were made.
ArrayList<DrawAction> actions = new ArrayList<DrawAction>();

// Background actions.
// These are the actions established by SHIFT / setBg().
ArrayList<DrawAction> bgActions = new ArrayList<DrawAction>();

ArrayList<Point> bgPoints = new ArrayList<Point>();
ArrayList<Fill> bgFills = new ArrayList<Fill>();

ArrayList<String> forwardLoop = new ArrayList<String>();
ArrayList<String> backwardLoop = new ArrayList<String>();

boolean forwardLoopOn;
boolean backwardLoopOn;

DrawMode mode;

boolean layerMode;
boolean traceMode;
boolean traceOverMode;

boolean fillMode = false;

// Fill tolerance.
// Lower = more exact.
// Higher = more forgiving but more likely to leak through boundaries.
int fillTolerance = 20;

float brushSize = 5;

color pen = color(255, 200);

PImage image;
PImage bg;
PImage img;
PImage layerFrame;
PImage traceFrame;


// ------------------------------------------------------------
// COLOUR PICKER
// ------------------------------------------------------------

boolean colourPickerOpen = false;

ArrayList<Integer> colourHistory = new ArrayList<Integer>();

color pickerSelection;
int pickerAlpha;

int pickerX = 20;
int pickerY = 20;
int pickerW = 300;
int pickerH = 200;

PImage colourPickerImage;


// ------------------------------------------------------------
// DRAW ACTION CLASSES
// ------------------------------------------------------------

// Base class for anything that can be replayed.
class DrawAction {
}


// ------------------------------------------------------------
// POINT
// ------------------------------------------------------------

class Point extends DrawAction {

  PVector pos;
  color pen;
  float size;
  DrawMode mode;

  Point(PVector pos, color pen, float size, DrawMode mode) {
    this.pos = pos;
    this.pen = pen;
    this.size = size;
    this.mode = mode;
  }

  Point clone() {
    return new Point(
      pos.copy(),
      pen,
      size,
      mode
    );
  }
}


// ------------------------------------------------------------
// FILL
// ------------------------------------------------------------

class Fill extends DrawAction {

  int x;
  int y;

  color fillColor;

  int tolerance;

  Fill(int x, int y, color fillColor, int tolerance) {
    this.x = x;
    this.y = y;
    this.fillColor = fillColor;
    this.tolerance = tolerance;
  }

  Fill clone() {
    return new Fill(
      x,
      y,
      fillColor,
      tolerance
    );
  }
}


// ------------------------------------------------------------
// SETUP
// ------------------------------------------------------------

void setup() {

  // size(1080, 1080);
  fullScreen();

  background(bgColor);

  setLastFrame("frame", "png");

  mode = DrawMode.SINGLE;

  buildColourPicker();

  pickerSelection = pen;

  pickerAlpha = int(alpha(pen));
}


// ------------------------------------------------------------
// DRAW
// ------------------------------------------------------------

void draw() {

  if (colourPickerOpen) {
    drawColourPicker();
  }
}


// ------------------------------------------------------------
// MOUSE
// ------------------------------------------------------------

void mousePressed() {

  // Colour picker takes priority.
  if (colourPickerOpen) {

    if (selectPickerColour()) {
      return;
    }

    selectHistoryColour();

    return;
  }


  // Fill mode.
  if (fillMode) {

    doFill(
      mouseX,
      mouseY
    );

    return;
  }
}


void mouseDragged() {

  // Don't draw while using the colour picker.
  if (colourPickerOpen) {
    return;
  }

  // Fill mode only works on click.
  if (fillMode) {
    return;
  }


  Point point = new Point(
    new PVector(mouseX, mouseY),
    pen,
    brushSize,
    mode
  );

  points.add(point);

  actions.add(point);

  drawPoint(point);
}


// ------------------------------------------------------------
// FILL
// ------------------------------------------------------------

void doFill(int x, int y) {

  Fill f = new Fill(
    x,
    y,
    pen,
    fillTolerance
  );

  // Record the fill.
  fills.add(f);

  // Record it in the same action stream as drawing.
  actions.add(f);

  // Immediately perform it on the visible canvas.
  drawFill(f);
}


void drawFill(Fill f) {

  floodFill(
    f.x,
    f.y,
    f.fillColor,
    f.tolerance
  );
}


// ------------------------------------------------------------
// FLOOD FILL
// ------------------------------------------------------------
//
// Scanline flood fill.
// This avoids recursive calls, which can easily overflow the
// Java stack when filling large areas.
//
// The fill uses colour tolerance so anti-aliased / translucent
// brush boundaries don't have to be perfectly solid.
//

void floodFill(
  int startX,
  int startY,
  color newColor,
  int tolerance
) {

  startX = constrain(
    startX,
    0,
    width - 1
  );

  startY = constrain(
    startY,
    0,
    height - 1
  );


  loadPixels();


  int target =
    pixels[startY * width + startX];


  // If the new colour is already close enough,
  // there is nothing to do.
  if (colourDistance(target, newColor) <= tolerance) {

    updatePixels();

    return;
  }


  ArrayList<PVector> stack =
    new ArrayList<PVector>();


  stack.add(
    new PVector(
      startX,
      startY
    )
  );


  while (stack.size() > 0) {

    PVector p =
      stack.remove(
        stack.size() - 1
      );


    int x = int(p.x);
    int y = int(p.y);


    if (
      x < 0 ||
      x >= width ||
      y < 0 ||
      y >= height
      ) {

      continue;
    }


    int index =
      y * width + x;


    if (
      !sameColour(
        pixels[index],
        target,
        tolerance
        )
      ) {

      continue;
    }


    // --------------------------------------------------------
    // Find left edge
    // --------------------------------------------------------

    int left = x;

    while (
      left >= 0 &&
      sameColour(
        pixels[y * width + left],
        target,
        tolerance
        )
      ) {

      left--;
    }

    left++;


    // --------------------------------------------------------
    // Find right edge
    // --------------------------------------------------------

    int right = x;

    while (
      right < width &&
      sameColour(
        pixels[y * width + right],
        target,
        tolerance
        )
      ) {

      right++;
    }

    right--;


    // --------------------------------------------------------
    // Fill this horizontal span
    // --------------------------------------------------------

    for (int i = left; i <= right; i++) {

      int pixelIndex =
        y * width + i;

      // Composite the fill colour over the existing canvas
      // rather than simply replacing the pixel. This means
      // your translucent pen colours behave like translucent
      // paint.
      pixels[pixelIndex] =
        compositeFillColour(
          pixels[pixelIndex],
          newColor
        );
    }


    // --------------------------------------------------------
    // Search row above
    // --------------------------------------------------------

    if (y > 0) {

      addFillSpans(
        stack,
        y - 1,
        left,
        right,
        target,
        tolerance
      );
    }


    // --------------------------------------------------------
    // Search row below
    // --------------------------------------------------------

    if (y < height - 1) {

      addFillSpans(
        stack,
        y + 1,
        left,
        right,
        target,
        tolerance
      );
    }
  }


  updatePixels();
}


// ------------------------------------------------------------
// ADD FILL SPANS
// ------------------------------------------------------------

void addFillSpans(
  ArrayList<PVector> stack,
  int y,
  int left,
  int right,
  color target,
  int tolerance
) {

  boolean inSpan = false;


  for (int x = left; x <= right; x++) {

    boolean match =
      sameColour(
        pixels[y * width + x],
        target,
        tolerance
      );


    if (match && !inSpan) {

      stack.add(
        new PVector(
          x,
          y
        )
      );

      inSpan = true;

    } else if (!match) {

      inSpan = false;
    }
  }
}


// ------------------------------------------------------------
// COLOUR COMPARISON
// ------------------------------------------------------------

boolean sameColour(
  color a,
  color b,
  int tolerance
) {

  return colourDistance(a, b) <= tolerance;
}


float colourDistance(
  color a,
  color b
) {

  float dr =
    red(a) - red(b);

  float dg =
    green(a) - green(b);

  float db =
    blue(a) - blue(b);


  return sqrt(
    dr * dr +
    dg * dg +
    db * db
  );
}


// ------------------------------------------------------------
// COMPOSITE TRANSLUCENT FILL
// ------------------------------------------------------------
//
// Unlike assigning newColor directly to pixels[], this keeps
// the canvas opaque and composites translucent pen colours
// over the existing pixel.
//

color compositeFillColour(
  color base,
  color over
) {

  float a =
    alpha(over) / 255.0;


  float r =
    lerp(
      red(base),
      red(over),
      a
    );

  float g =
    lerp(
      green(base),
      green(over),
      a
    );

  float b =
    lerp(
      blue(base),
      blue(over),
      a
    );


  return color(
    r,
    g,
    b,
    255
  );
}


// ------------------------------------------------------------
// DRAW ACTION
// ------------------------------------------------------------

void drawAction(DrawAction action) {

  if (action instanceof Point) {

    drawPoint(
      (Point) action
    );

  } else if (action instanceof Fill) {

    drawFill(
      (Fill) action
    );
  }
}


// ------------------------------------------------------------
// DRAW ALL ACTIONS
// ------------------------------------------------------------

void drawActions(
  ArrayList<DrawAction> actionList
) {

  for (DrawAction action : actionList) {

    drawAction(action);
  }
}


// ------------------------------------------------------------
// COLOUR PICKER
// ------------------------------------------------------------

void buildColourPicker() {

  colourPickerImage =
    createImage(
      pickerW,
      pickerH,
      RGB
    );


  colourPickerImage.loadPixels();


  for (int x = 0; x < pickerW; x++) {

    float h =
      map(
        x,
        0,
        pickerW,
        0,
        255
      );


    for (int y = 0; y < pickerH; y++) {

      float s =
        map(
          y,
          0,
          pickerH,
          255,
          0
        );


      colourPickerImage.pixels[
        y * pickerW + x
      ] =
        colorHSB(
          h,
          s,
          255
        );
    }
  }


  colourPickerImage.updatePixels();
}


color colorHSB(
  float h,
  float s,
  float b
) {

  colorMode(
    HSB,
    255
  );

  color c =
    color(
      h,
      s,
      b
    );

  colorMode(
    RGB,
    255
  );

  return c;
}


void drawColourPicker() {

  noTint();

  image(
    colourPickerImage,
    pickerX,
    pickerY
  );


  stroke(255);

  noFill();

  rect(
    pickerX,
    pickerY,
    pickerW,
    pickerH
  );


  drawColourHistory();


  fill(pen);

  stroke(255);

  rect(
    pickerX,
    pickerY + pickerH + 80,
    60,
    60
  );


  fill(255);

  text(
    "α " + pickerAlpha,
    pickerX,
    pickerY + pickerH + 160
  );
}


void drawColourHistory() {

  int swatchSize = 30;

  int historyY =
    pickerY + pickerH + 20;


  for (
    int i = 0;
    i < colourHistory.size();
    i++
    ) {

    int x =
      pickerX +
      i * (swatchSize + 5);


    fill(
      colourHistory.get(i)
    );

    stroke(255);


    rect(
      x,
      historyY,
      swatchSize,
      swatchSize
    );
  }
}


void addColourToHistory(color c) {

  if (
    colourHistory.size() > 0 &&
    colourHistory.get(
      colourHistory.size() - 1
    ) == c
    ) {

    return;
  }


  for (color existing : colourHistory) {

    if (existing == c) {
      return;
    }
  }


  colourHistory.add(c);


  if (colourHistory.size() > 20) {

    colourHistory.remove(0);
  }
}


void toggleColourPicker() {

  if (colourPickerOpen) {

    addColourToHistory(
      pickerSelection
    );

    colourPickerOpen = false;

    redrawCurrentCanvas();

  } else {

    pickerSelection = pen;

    pickerAlpha = int(alpha(pen));

    colourPickerOpen = true;
  }
}


void selectHistoryColour() {

  int swatchSize = 30;

  int historyY =
    pickerY + pickerH + 20;


  for (
    int i = 0;
    i < colourHistory.size();
    i++
    ) {

    int x =
      pickerX +
      i * (swatchSize + 5);


    if (
      mouseX >= x &&
      mouseX <= x + swatchSize &&
      mouseY >= historyY &&
      mouseY <= historyY + swatchSize
      ) {

      pen =
        colourHistory.get(i);

      pickerSelection = pen;

      pickerAlpha =
        int(alpha(pen));

      return;
    }
  }
}


boolean selectPickerColour() {

  if (
    mouseX < pickerX ||
    mouseX > pickerX + pickerW ||
    mouseY < pickerY ||
    mouseY > pickerY + pickerH
    ) {

    return false;
  }


  int px =
    mouseX - pickerX;

  int py =
    mouseY - pickerY;


  color chosen =
    colourPickerImage.get(
      px,
      py
    );


  pickerSelection = chosen;

  pen = chosen;

  pickerAlpha =
    int(alpha(pen));


  return true;
}


// ------------------------------------------------------------
// REDRAW CURRENT CANVAS
// ------------------------------------------------------------

void redrawCurrentCanvas() {

  background(bgColor);


  if (traceFrame != null) {

    tint(
      255,
      traceOverMode ? 255 : 160
    );

    drawImageCentered(
      traceFrame
    );
  }


  if (layerFrame != null) {

    tint(
      255,
      traceMode ? 160 : 255
    );

    drawImageCentered(
      layerFrame
    );
  }


  drawBgFromData();


  // Replay current drawing in exact chronological order.
  drawActions(actions);

  noTint();
}


// ------------------------------------------------------------
// ALPHA
// ------------------------------------------------------------

void incrementAlpha(int delta) {

  int a =
    int(alpha(pen));


  a += delta;

  a =
    constrain(
      a,
      5,
      255
    );


  pen =
    color(
      red(pen),
      green(pen),
      blue(pen),
      a
    );


  pickerAlpha = a;
}


// ------------------------------------------------------------
// CREATE FRAMES
// ------------------------------------------------------------

void createFrames() {

  File f =
    new File(
      savePath("lastFrame.png")
    );


  if (f.exists()) {

    tint(
      255,
      255
    );

    PImage p =
      loadImage(
        savePath("lastFrame.png")
      );

    drawImageCentered(p);

  } else {

    background(bgColor);
  }


  // Replay actions in their original order.
  for (
    int i = 0;
    i < actions.size();
    i++
    ) {

    drawAction(
      actions.get(i)
    );


    if (
      i % liveDrawingThreshold == 0
      ) {

      saveIncremental(
        "frame",
        "png"
      );
    }
  }


  println(
    "all frames created"
  );


  forwardLoopOn = false;

  println(
    "Forward loop OFF"
  );


  backwardLoopOn = false;

  println(
    "Backward loop OFF"
  );
}


// ------------------------------------------------------------
// DRAW POINT
// ------------------------------------------------------------

void drawPoint(Point point) {

  stroke(point.pen);

  fill(point.pen);


  ellipse(
    point.pos.x,
    point.pos.y,
    point.size / 3,
    point.size / 3
  );


  switch (point.mode) {

  case SINGLE:

    // Already done.
    break;


  case MIRROR:

    ellipse(
      width - point.pos.x,
      point.pos.y,
      point.size / 3,
      point.size / 3
    );

    break;


  case LAKE:

    ellipse(
      point.pos.x,
      height - point.pos.y,
      point.size / 3,
      point.size / 3
    );

    break;


  case INDIA:

    ellipse(
      point.pos.x,
      height - point.pos.y,
      point.size / 3,
      point.size / 3
    );


    ellipse(
      width - point.pos.x,
      height - point.pos.y,
      point.size / 3,
      point.size / 3
    );


    ellipse(
      width - point.pos.x,
      point.pos.y,
      point.size / 3,
      point.size / 3
    );

    break;


  default:

    println(
      "ERROR - DEFAULT MODE: " +
      point.mode +
      " @drawPoint()"
    );
  }
}


// ------------------------------------------------------------
// IMAGE
// ------------------------------------------------------------

void drawImageCentered(PImage img) {

  if (img == null) {
    return;
  }


  imageMode(CENTER);

  image(
    img,
    width / 2,
    height / 2
  );

  imageMode(CORNER);
}


// ------------------------------------------------------------
// SET BACKGROUND
// ------------------------------------------------------------

void setBg() {

  // Copy the complete current action history.
  // This includes both points and fills.
  bgActions =
    new ArrayList<DrawAction>();


  bgPoints =
    new ArrayList<Point>();


  bgFills =
    new ArrayList<Fill>();


  for (DrawAction action : actions) {

    if (action instanceof Point) {

      Point p =
        ((Point) action).clone();

      bgPoints.add(p);

      bgActions.add(p);

    } else if (action instanceof Fill) {

      Fill f =
        ((Fill) action).clone();

      bgFills.add(f);

      bgActions.add(f);
    }
  }


  saveBgData();


  saveFrame(
    savePath("bg.png")
  );


  bg =
    loadImage("bg.png");
}


// ------------------------------------------------------------
// SAVE BACKGROUND DATA
// ------------------------------------------------------------
//
// New format:
//
// P|[ x, y, z ]|color|size|mode
// F|x|y|color|tolerance
//
// The loader below also supports your old point-only bg.txt.
//

void saveBgData() {

  PrintWriter output =
    createWriter("bg.txt");


  for (DrawAction action : bgActions) {

    if (action instanceof Point) {

      Point p =
        (Point) action;


      output.println(
        "P|" +
        p.pos +
        "|" +
        p.pen +
        "|" +
        p.size +
        "|" +
        p.mode.name()
      );


    } else if (action instanceof Fill) {

      Fill f =
        (Fill) action;


      output.println(
        "F|" +
        f.x +
        "|" +
        f.y +
        "|" +
        f.fillColor +
        "|" +
        f.tolerance
      );
    }
  }


  output.flush();

  output.close();
}


// ------------------------------------------------------------
// DRAW BACKGROUND FROM DATA
// ------------------------------------------------------------

void drawBgFromData() {

  if (bgActions != null && bgActions.size() > 0) {

    drawActions(bgActions);

    return;
  }


  // Try file if there isn't already background data.
  File f =
    new File(
      sketchPath("bg.txt")
    );


  if (!f.exists()) {
    return;
  }


  bgActions =
    new ArrayList<DrawAction>();


  bgPoints =
    new ArrayList<Point>();


  bgFills =
    new ArrayList<Fill>();


  String[] lines =
    loadStrings("bg.txt");


  for (String s : lines) {

    if (s == null || s.trim().length() == 0) {
      continue;
    }


    // --------------------------------------------------------
    // New fill format
    // --------------------------------------------------------

    if (s.startsWith("F|")) {

      String[] p =
        s.split("\\|");


      if (p.length >= 5) {

        int x =
          int(p[1]);

        int y =
          int(p[2]);

        color c =
          color(
            int(p[3])
          );

        int tolerance =
          int(p[4]);


        Fill fill =
          new Fill(
            x,
            y,
            c,
            tolerance
          );


        bgFills.add(fill);

        bgActions.add(fill);
      }


      continue;
    }


    // --------------------------------------------------------
    // New point format
    // --------------------------------------------------------

    if (s.startsWith("P|")) {

      String[] p =
        s.split("\\|");


      if (p.length >= 5) {

        String position =
          p[1];


        position =
          position
          .replace("[", "")
          .replace("]", "")
          .trim();


        String[] coS =
          position.split(",");


        float x =
          float(
            coS[0].trim()
          );


        float y =
          float(
            coS[1].trim()
          );


        PVector pv =
          new PVector(
            x,
            y
          );


        color c =
          color(
            int(p[2])
          );


        float size =
          float(p[3]);


        DrawMode m =
          DrawMode.valueOf(
            p[4]
          );


        Point point =
          new Point(
            pv,
            c,
            size,
            m
          );


        bgPoints.add(point);

        bgActions.add(point);
      }


      continue;
    }


    // --------------------------------------------------------
    // OLD POINT FORMAT
    // --------------------------------------------------------
    //
    // Your original bg.txt used:
    //
    // [ x, y, z ]|color|size|mode
    //
    // Keep support for that format so old projects still load.
    //

    String[] p =
      s.split("\\|");


    if (p.length >= 4) {

      String position =
        p[0]
        .replace("[", "")
        .replace("]", "")
        .trim();


      String[] coS =
        position.split(",");


      if (coS.length >= 2) {

        float x =
          float(
            coS[0].trim()
          );


        float y =
          float(
            coS[1].trim()
          );


        PVector pv =
          new PVector(
            x,
            y
          );


        color c =
          color(
            int(p[1])
          );


        float size =
          float(p[2]);


        DrawMode m =
          DrawMode.valueOf(
            p[3]
          );


        Point point =
          new Point(
            pv,
            c,
            size,
            m
          );


        bgPoints.add(point);

        bgActions.add(point);
      }
    }
  }


  // Render loaded background.
  drawActions(bgActions);
}


// ------------------------------------------------------------
// NEXT FRAME
// ------------------------------------------------------------

void next() {

  if (traceMode) {

    if (!traceOverMode) {

      background(bgColor);
    }


    if (
      layerMode &&
      layerFrame != null
      ) {

      tint(
        255,
        255
      );

      drawImageCentered(
        layerFrame
      );
    }


    drawBgFromData();


    // Replay current frame.
    drawActions(actions);
  }


  saveIncremental(
    "frame",
    "png"
  );


  saveFrame(
    savePath("lastFrame.png")
  );


  tint(
    255,
    160
  );


  if (
    layerFrame == null &&
    traceFrame == null
    ) {

    bg =
      loadImage("bg.png");


    if (bg != null) {

      drawImageCentered(bg);

    } else {

      fill(
        bgColor,
        200
      );

      stroke(
        bgColor,
        200
      );


      rect(
        0,
        0,
        width,
        height
      );
    }


  } else if (
    layerFrame != null &&
    traceFrame == null
    ) {

    drawImageCentered(
      layerFrame
    );

    drawBgFromData();


  } else if (
    traceFrame != null &&
    layerFrame == null
    ) {

    if (traceOverMode) {

      tint(255);

      background(bgColor);

      tint(
        255,
        160
      );


      drawActions(actions);
    }


    drawImageCentered(
      traceFrame
    );

    drawBgFromData();


  } else {

    drawImageCentered(
      traceFrame
    );

    drawImageCentered(
      layerFrame
    );

    drawBgFromData();
  }


  // Current frame is finished.
  // Start the next frame with a clean action list.
  points.clear();

  fills.clear();

  actions.clear();

  noTint();
}


// ------------------------------------------------------------
// SAVE INCREMENTAL
// ------------------------------------------------------------

void saveIncremental(
  String prefix,
  String extension
) {

  int savecnt =
    findNextFreeFrameIndex(
      prefix,
      extension
    );


  String filename =
    frameName(
      savecnt,
      prefix,
      extension
    );


  if (traceMode) {

    traceFrame =
      loadFrameFromFolder(
        "trace"
      );
  }


  if (layerMode) {

    layerFrame =
      loadFrameFromFolder(
        "layer"
      );
  }


  println(
    "Saving " + filename
  );


  saveFrame(
    savePath(filename)
  );


  if (forwardLoopOn) {

    forwardLoop.add(filename);
  }


  if (backwardLoopOn) {

    backwardLoop.add(filename);
  }
}


// ------------------------------------------------------------
// FRAME NAME
// ------------------------------------------------------------

String frameName(
  int index,
  String prefix,
  String extension
) {

  return prefix +
    nf(index, 4) +
    "." +
    extension;
}


// ------------------------------------------------------------
// FIND NEXT FRAME
// ------------------------------------------------------------

int findNextFreeFrameIndex(
  String prefix,
  String extension
) {

  int i = 1;


  while (true) {

    String filename =
      frameName(
        i,
        prefix,
        extension
      );


    File f =
      new File(
        savePath(filename)
      );


    if (!f.exists()) {

      return i;
    }


    i++;
  }
}


