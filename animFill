// ------------------------------------------------------------
// COLOUR KEYS
// ------------------------------------------------------------

void handleColorKeys() {

  switch (key) {

  case 'w':

    pen = PEN_WHITE;

    break;


  case 'z':

    pen = PEN_TRANSPARENT;

    break;


  case '0':

    pen = PEN_BLACK;

    break;


  case '9':

    pen = PEN_SHADE;

    break;


  case 'h':

    pen = PEN_GREY;

    break;


  case 'r':

    pen = PEN_RED;

    break;


  case 'b':

    pen = PEN_BLUE;

    break;


  case 'g':

    pen = PEN_GREEN;

    break;


  case 'y':

    pen = PEN_YELLOW;

    break;


  case 'p':

    pen = PEN_PURPLE;

    break;


  case 'o':

    pen = PEN_ORANGE;

    break;


  case 'u':

    pen = PEN_BROWN;

    break;


  case '[':

  case ']':

    incrementColour(key);

    break;


  case ',':

    incrementAlpha(-5);

    break;


  case '.':

    incrementAlpha(5);

    break;


  case '-':

    incrementAlpha(-100);

    break;


  case '=':

    incrementAlpha(100);

    break;
  }


  pickerSelection = pen;

  pickerAlpha =
    int(alpha(pen));
}


