void flipBackgroundColour() {

  if (bgColor == 0) {

    bgColor = 255;

  } else {

    bgColor = 0;
  }


  background(bgColor);
}


// ------------------------------------------------------------
// COLOUR ADJUSTMENT
// ------------------------------------------------------------

void incrementColour(char key) {

  float r =
    red(pen);

  float g =
    green(pen);

  float b =
    blue(pen);


  if (key == '[') {

    r =
      max(
        0,
        r - 5
      );

    g =
      max(
        0,
        g - 5
      );

    b =
      max(
        0,
        b - 5
      );


  } else if (key == ']') {

    r =
      min(
        255,
        r + 5
      );

    g =
      min(
        255,
        g + 5
      );

    b =
      min(
        255,
        b + 5
      );
  }


  pen =
    color(
      r,
      g,
      b,
      alpha(pen)
    );


  pickerSelection = pen;

  pickerAlpha =
    int(alpha(pen));
}


